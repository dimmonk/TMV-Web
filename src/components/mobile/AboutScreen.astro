---
/**
 * About — phone composition. MobileHero + facility tiles (using the facility
 * data's `mobile` body override) + a Visit-us block. See HomeScreen for the switch.
 */
import MobileHero from '../MobileHero.astro';
import { url } from '../../data/site';
import { hours, contact } from '../../data/site-config';
import { hoursStat, hoursSummary } from '../../lib/opening-hours.js';
import { facility } from '../../data/facility';
import { forSurface } from '../../data/surface';

const cards = forSurface(facility, 'mobile');
const hoursLine = hoursSummary(hours);
const daysOpen = hoursStat(hours)?.value;
const heroStats = [{ v: '10k+', l: 'sq ft' }, { v: 'Ages 3+', l: 'all levels' }, { v: daysOpen ?? '', l: 'a week', hoursDays: true, hidden: !daysOpen }];
---
<MobileHero eyebrow="Visit us" title="Come see the space" desc="10,000+ sq ft of parkour rigs, foam pits, a sprung gymnastics floor and a full strength section, all under one roof." stats={heroStats} />
<div class="m-pad">
  <div class="m-visit">
    <div class="m-visit-eyebrow"><span class="mh-rule"></span>Visit us</div>
    <div class="m-visit-rows">
      <div class="m-visit-row" data-contact-wrap="address" hidden={!contact.line}><i class="bi bi-geo-alt-fill" aria-hidden="true"></i><div><div class="m-visit-t" data-contact="street" hidden={!contact.street}>{contact.street}</div><div class="m-visit-s" data-contact="locality" hidden={!contact.locality}>{contact.locality}</div></div></div>
      <div class="m-visit-row" data-hours-wrap hidden={!hoursLine}><i class="bi bi-clock-fill" aria-hidden="true"></i><div><div class="m-visit-t" data-hours-summary>{hoursLine}</div></div></div>
      <div class="m-visit-btns">
        <a href={contact.href.directions || undefined} data-contact-href="directions" hidden={!contact.href.directions} target="_blank" rel="noopener" class="m-visit-btn"><i class="bi bi-geo-alt"></i> Directions</a>
        <a href={contact.href.phone || undefined} data-contact-href="phone" hidden={!contact.href.phone} class="m-visit-btn"><i class="bi bi-telephone-fill"></i> Call us</a>
      </div>
    </div>
  </div>
  <div style="height:30px"></div>

  <h3 class="m-h3" style="margin:0 0 4px">Our facility</h3>
  <p class="m-sub" style="margin-bottom:14px">Built for every kind of mover.</p>
  <div class="m-tiles" style="margin-bottom:30px">
    {cards.map((f) => (
      <div class="tile m-tile" style="cursor:default">
        <span class="m-tile-ic" style="background:#eceae4"><i class={`bi ${f.icon}`} style="color:#211f1b" aria-hidden="true"></i></span>
        <div><div class="m-tile-t">{f.title}</div><div class="m-tile-s">{f.body}</div></div>
      </div>
    ))}
  </div>

  <a href={url('get-started')} class="m-darkbtn" style="margin-top:18px">New here? Start your first visit <i class="bi bi-arrow-right"></i></a>
</div>
