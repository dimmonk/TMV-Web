---
/**
 * Schedule — the phone composition, verbatim from the /m/ app's `schedule`
 * screen. The chips, week bar, changes card and day cards are rendered by
 * src/lib/mobile-schedule.ts.
 */
import MobileHero from '../MobileHero.astro';
import NextStep from '../NextStep.astro';
---
<MobileHero eyebrow="Schedule" title="This week at the gym" desc="Live class times you can filter by age, the same schedule our front desk runs from." />
<div style="padding:18px 0 28px">
  <div class="app-scroll m-chips" data-sched-chips></div>
  <div class="m-pad-x wk-phone-top" data-sched-weekbar hidden></div>
  <div class="m-pad-x" data-sched-body></div>
  <div class="m-pad-x" style="margin-top:20px"><NextStep step="weekly-athletic" /></div>
</div>

<script>
  import { mountMobileSchedule } from '../../lib/mobile-schedule';
  import { publishedSiteConfig } from '../../lib/live-site-config';
  // Re-fetch/re-render on every navigation; mountMobileSchedule no-ops when the
  // schedule targets aren't on the page.
  document.addEventListener('astro:page-load', () => mountMobileSchedule({ siteConfig: publishedSiteConfig }));
</script>
