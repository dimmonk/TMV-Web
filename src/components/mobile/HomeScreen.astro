---
import Priced from '../Priced.astro';
/**
 * Home — the phone composition, kept verbatim from the /m/ app's `home` screen.
 *
 * This is a genuinely different composition from the desktop homepage (stat-band
 * hero, row-button, stacked cards, review strip), not the desktop markup
 * narrowed. The page renders this below md and the desktop composition above —
 * both wrapped in data-chrome, so the single breakpoint rule in global.css
 * decides. Styles live in src/styles/mobile-app.css under `.mapp`.
 *
 * The only change from the original: the /m/ router's `data-goto="#screen"`
 * buttons are now real links to real routes.
 */
import ActivityLinks from '../ActivityLinks.astro';
import VisitSummary from '../VisitSummary.astro';
import BookingCard from '../BookingCard.astro';
import GoalPicker from '../GoalPicker.astro';
import ScheduleChanges from '../ScheduleChanges.astro';
import { cat, reviews, url } from '../../data/site';
import { heroStats } from '../../data/hero-stats';
import { nextSeason } from '../../data/camps';

const season = nextSeason();
const reviewItems = reviews.items.map((r) => ({ name: r.name, role: r.context, text: r.quote }));
---
<div class="m-home-hero">
  <div class="mh-glow"></div>
  <div class="m-home-hero-inner">
    <div class="mh-eyebrow"><span class="mh-rule"></span>Parkour &amp; movement · Toronto</div>
    <h2 class="m-home-title">Move better.<br>Have more fun.</h2>
    <p class="m-home-lead">Classes, open gym, camps and birthday parties — every age, every level, under one big roof.</p>
    <a class="m-brandbtn" href="#m-start" style="margin-bottom:22px">Find your starting point <i class="bi bi-arrow-down" aria-hidden="true"></i></a>
    <div class="m-home-stats">
      {heroStats.map((st, i) => (
        <div class:list={['m-home-stat', { mid: i > 0 && i < heroStats.length - 1, end: i === heroStats.length - 1 }]} data-hours-stat={st.hours ? '' : undefined} data-stat-variant={st.hours ? 'mobile' : undefined} hidden={st.hidden}><div class="m-home-statv" data-stat-value={st.hours ? '' : undefined}><Priced text={st.value} /></div><div class="m-home-statl" data-stat-label={st.hours ? '' : undefined}>{st.mobileLabel ?? st.label}</div></div>
      ))}
    </div>
  </div>
</div>

<div class="m-pad">
  {/* Staff's cancelled dates and closed days, only while there are any (the same card as the desktop home). */}
  <div style="--sched-changes-pad:0 0 26px"><ScheduleChanges /></div>

  {/* ASK -> RECOMMEND: same GoalPicker the desktop home renders, compact. */}
  <h3 class="m-h3" id="m-start" style="scroll-margin-top:80px">What are you here for?</h3>
  <p class="m-sub">Pick a goal and we'll point you to one first step.</p>
  <div style="margin-bottom:28px"><GoalPicker variant="compact" /></div>

  <h3 class="m-h3">Or browse</h3>
  <p class="m-sub">Ages, prices and how to join.</p>
  <div style="margin-bottom:30px"><ActivityLinks /></div>

  {/* The whole block goes when no season is open — a "Booking now" heading
      with nothing under it is worse than no section. */}
  {season && (
    <>
      <div class="m-rowhead">
        <h3 class="m-h3" style="margin:0">Camps booking now</h3>
        <a class="m-alllink" href={url('camps')}>All camps <i class="bi bi-arrow-right" style={`color:${cat.camps}`} aria-hidden="true"></i></a>
      </div>
      <div style="margin-bottom:30px">
        <BookingCard color={cat.camps} duration="9–2 daily" bookingTag="Register" title={season.label} description={`${season.when} — skills, flips, games and friends.`} pills="Ages 5–16 | Mon–Fri | All levels" price={season.price} priceNote="single days too" actionLabel="See dates" href={`${url('camps')}#m-dates`} />
      </div>
    </>
  )}

  <div class="m-revstrip">
    <div class="m-revstrip-top">
      <span class="m-revstrip-num">{reviews.ratingValue}</span>
      <div>
        <div class="m-revstrip-stars"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i></div>
        <div class="m-revstrip-count">{reviews.ratingCount.replace(/^Based on /, '')}</div>
      </div>
    </div>
    <div data-carousel>
      <div class="m-revviewport" data-rev-viewport>
        <div class="m-revtrack" data-rev-track>
          {reviewItems.map((r) => (
            <div class="m-hrev">
              <p class="m-revstrip-quote">“{r.text}”</p>
              <div class="m-hrev-by">{r.name} <span>· {r.role}</span></div>
            </div>
          ))}
        </div>
      </div>
      <div class="m-revnav">
        <button type="button" class="m-revarrow" data-rev-prev aria-label="Previous review"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
        <div class="m-revdots">
          {reviewItems.map((_, i) => <button type="button" class="m-revdot" data-rev-dot={i} aria-label={`Review ${i + 1}`}></button>)}
        </div>
        <button type="button" class="m-revarrow" data-rev-next aria-label="Next review"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
      </div>
    </div>
  </div>
  <div style="margin-top:30px"><VisitSummary /></div>
</div>

<script>
  import { mountReviewCarousels } from '../../lib/review-carousel';
  // Re-init on every navigation; harmless on pages without a carousel (no-op).
  document.addEventListener('astro:page-load', () => mountReviewCarousels());
</script>
