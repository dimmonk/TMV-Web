---
/**
 * The announcement banner staff set in the members app (Settings -> Website ->
 * Announcements): a headline, an optional message, an optional button, shown
 * from its first day to the end of its last (`lib/site-banner.js`).
 *
 * It is visible only when `site-config.ts` found a banner whose days include
 * the gym's today; otherwise the element is `hidden` and empty, so nothing
 * shows, not an empty strip. It is always in the markup because the browser
 * picks again on page load (`lib/live-site-config.ts`, `apply-site-config.js`),
 * so the next banner of the year shows on its first day with no release. It
 * sits above both chromes and scrolls away with the page.
 *
 * The days are checked at build time and again in the browser (the script
 * below), so a banner whose last day passed between two releases still comes
 * down by itself, even if the published object cannot be fetched. The browser
 * reads the gym's clock, the same one the build uses.
 */
import { promo } from '../data/site-config';
import { bannerButton } from '../lib/site-banner.js';

const button = promo ? bannerButton(promo) : null;
---
<aside class="promo" data-promo data-from={promo?.from ?? ''} data-to={promo?.to ?? ''} hidden={!promo} aria-label="Announcement">
  <div class="promo-in container">
    <strong class="promo-head" data-promo-head>{promo?.headline}</strong>
    <span class="promo-body" data-promo-body hidden={!promo?.body}>{promo?.body}</span>
    <a class="promo-cta" data-promo-cta href={button?.href} hidden={!button} target="_blank" rel="noopener">{button?.label}</a>
  </div>
</aside>

<style>
  .promo { background: var(--brand); color: var(--ink); }
  .promo-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 14px; padding-block: 10px; text-align: center; }
  .promo-head { font: 800 14px/1.25 var(--font-display); letter-spacing: .01em; }
  .promo-body { font: 500 13.5px/1.35 var(--font-body); }
  .promo-cta { font: 800 12px/1 var(--font-display); letter-spacing: .06em; text-transform: uppercase; background: var(--ink); color: #fff; text-decoration: none; padding: 8px 12px; border-radius: 8px; }
</style>

<script>
  import { bannerShowsOn, gymDay } from '../lib/site-banner.js';
  import { gymNow } from '../lib/gym-clock.js';

  function expireBanner() {
    const day = gymDay(gymNow().wall);
    document.querySelectorAll<HTMLElement>('[data-promo]').forEach((el) => {
      if (!bannerShowsOn({ from: el.dataset.from ?? '', to: el.dataset.to ?? '' }, day)) el.hidden = true;
    });
  }
  document.addEventListener('astro:page-load', expireBanner);
</script>
