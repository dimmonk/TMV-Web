---
/**
 * The four things a family comes for, as one row of cards.
 * Replaces the three flip cards on Home: everything a parent needs is on the face, nothing hides behind a flip.
 * Content only, width-agnostic (THE RULE): four across on desktop, two across from 1024px down.
 */
import { url, cat } from '../data/site';
import { isVideoAsset } from '../lib/class-media';

const items = [
  { title: 'Classes', description: 'Coached parkour, flips & movement.', detail: 'Ages 3+ · kids, teens & adults', price: 'From $30 / class', href: url('train'), color: cat.classes, image: 'assets/recreational.gif', action: 'Find your class' },
  { title: 'Open Gym', description: 'Come play or train at your own pace.', detail: 'All ages · no booking needed', price: '$25 / day', href: url('open-gym'), color: cat.openGym, image: 'assets/gym-01.jpg', action: 'Plan a visit' },
  { title: 'Camps', description: 'Skills, games & friends on days off.', detail: 'Ages 5 to 16 · 9 AM–2 PM', price: '$90 / day · $350 / week', href: url('camps'), color: cat.camps, image: 'assets/camp-weekly.png', action: 'See dates' },
  { title: 'Birthday Parties', description: 'Coached fun for the birthday crew.', detail: 'Full party ages 5+ · mini ages 8+', price: 'Full party from $350', href: url('events'), color: cat.parties, image: 'assets/invite-default-photo.png', action: 'Plan a party' },
];
---
<div class="activities">
  {items.map((item) => (
    <a class="activity" href={item.href} style={`--accent:${item.color}`}>
      {isVideoAsset(item.image)
        ? <video class="activity-media" src={url(item.image)} autoplay muted loop playsinline preload="none" aria-label={`${item.title} at The Monkey Vault`}></video>
        : <img class="activity-media" src={url(item.image)} alt="" loading="lazy" />}
      <div class="activity-body">
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <span class="activity-detail">{item.detail}</span>
        <strong>{item.price}</strong>
        <span class="activity-action">{item.action}<i class="bi bi-arrow-right" aria-hidden="true"></i></span>
      </div>
    </a>
  ))}
</div>
<style>
  .activities { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .activity { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; text-decoration: none; color: var(--ink); box-shadow: var(--shadow-sm); transition: transform .2s; }
  .activity:hover { transform: translateY(-4px); }
  .activity-media { display: block; width: 100%; height: 154px; object-fit: cover; background: var(--ink); }
  .activity-body { padding: 21px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  h3 { font: 800 22px/1.1 var(--font-display); margin: 0; }
  p { font-size: 14px; color: var(--text-3); margin: 0; }
  .activity-detail { font-size: 12px; color: var(--muted); margin-top: auto; }
  .activity strong { font: 800 16px/1.3 var(--font-display); }
  .activity-action { display: flex; align-items: center; justify-content: space-between; gap: 8px; border-top: 1px solid var(--line-soft); padding-top: 14px; font: 800 11px/1.4 var(--font-display); text-transform: uppercase; letter-spacing: .03em; }
  .activity-action i { color: var(--accent); }
  @media (max-width: 1024px) { .activities { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .activities { gap: 12px; }
    .activity-media { height: 100px; }
    .activity-body { padding: 14px; gap: 8px; }
    h3 { font-size: 18px; } p { font-size: 12.5px; } .activity strong { font-size: 14px; }
    .activity-detail { font-size: 11.5px; } .activity-action { font-size: 10.5px; }
  }
</style>
