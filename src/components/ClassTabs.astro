---
/**
 * The Specialized Classes card — ONE card, a tab per discipline.
 *
 * Eleven specialized classes used to render as eleven full flip cards, which
 * was the single biggest source of visual overload on the Train page. Here the
 * whole discipline LIST stays visible as a tab strip (so nothing is hidden from
 * a skimmer, or from search — every panel is server-rendered), but only one
 * discipline is shown at a time.
 *
 * Nothing is lost in the collapse: the flip card's front (clip, booking tag,
 * pills, action) and its back (headline, body, spec table) are merged into the
 * one panel, so there is no second side to discover.
 *
 * Content only — no chrome, no fixed width. The same component renders in both
 * chromes; `variant="compact"` is a density knob, not a second implementation.
 * Logic is src/lib/class-tabs.ts.
 */
import { url, cat } from '../data/site';
import { isVideoAsset, classMediaExists } from '../lib/class-media';
import type { ClassItem } from '../data/classes';

interface Props {
  classes: ClassItem[];
  variant?: 'full' | 'compact';
}
const { classes, variant = 'full' } = Astro.props;

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const bookingIconMap: Record<string, string> = {
  'Drop-in': 'bi-door-open', 'By appointment': 'bi-calendar-check', 'Membership': 'bi-arrow-repeat',
  'Register': 'bi-calendar-event', 'Direct with coach': 'bi-chat-dots',
};

// Every specialized class carries the shared `classes` accent (same mapping
// ClassCard uses), so the strip reads as one family rather than eleven colours.
const accent = cat.classes;

const items = classes.map((c) => ({
  id: slug(c.title),
  title: c.title,
  headline: c.backHeadline,
  body: c.backBody || c.description,
  bookingTag: c.bookingTag,
  bookingIcon: bookingIconMap[c.bookingTag] || 'bi-info-circle',
  pills: c.pills.split('|').map((s) => s.trim()).filter(Boolean),
  specs: c.specs.split('||').map((s) => s.trim()).filter(Boolean).map((row) => {
    const i = row.indexOf(':');
    return i >= 0 ? { label: row.slice(0, i).trim(), value: row.slice(i + 1).trim() } : { label: '', value: row };
  }),
  actionLabel: c.actionLabel,
  href: 'external' in c.link ? c.link.external : url(c.link.screen),
  external: 'external' in c.link,
  src: c.image.startsWith('assets/') ? url(c.image) : c.image,
  isVideo: isVideoAsset(c.image),
  mediaExists: classMediaExists(c.image),
}));
---
<div class:list={['ct', variant]} style={`--cat:${accent}`} data-class-tabs>
  <div class="ct-tabs" role="tablist" aria-label="Specialized classes">
    {items.map((it, i) => (
      <button
        type="button" class:list={['ct-tab', { on: i === 0 }]} data-class-tab={it.id}
        role="tab" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
      >{it.title}</button>
    ))}
  </div>

  {items.map((it, i) => (
    <div class="ct-panel" data-class-panel={it.id} role="tabpanel" aria-label={it.title} hidden={i !== 0}>
      <div class="ct-media">
        {!it.mediaExists
          ? <div class="ct-media-ph" aria-hidden="true"><i class="bi bi-person-arms-up"></i></div>
          : it.isVideo
          ? <video class="ct-img" src={it.src} muted loop playsinline webkit-playsinline preload="none"></video>
          : <img class="ct-img" src={it.src} alt={it.title} loading="lazy" />}
      </div>

      <div class="ct-body">
        {it.bookingTag && <span class="ct-booking"><i class={`bi ${it.bookingIcon}`} aria-hidden="true"></i>{it.bookingTag}</span>}
        <h3 class="ct-title">{it.title}</h3>
        {it.headline && <p class="ct-headline">{it.headline}</p>}
        <p class="ct-desc">{it.body}</p>
        {it.pills.length > 0 && <div class="ct-pills">{it.pills.map((p) => <span class="ct-pill">{p}</span>)}</div>}
        <div class="ct-specs">
          {it.specs.map((s) => (
            <div class="ct-spec"><span class="ct-spec-l">{s.label}</span><span class="ct-spec-v">{s.value}</span></div>
          ))}
        </div>
        <a href={it.href} class="ct-act" {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
          {it.actionLabel} <i class={`bi ${it.external ? 'bi-arrow-up-right' : 'bi-arrow-right'}`} aria-hidden="true"></i>
        </a>
      </div>
    </div>
  ))}
</div>

<style>
  .ct { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden; }

  /* The discipline list. Scrolls horizontally rather than wrapping to four
     rows — the strip is meant to read as one line you run your eye along. */
  .ct-tabs { display: flex; gap: 8px; padding: 14px 16px; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--line); background: #faf9f6; }
  .ct-tabs::-webkit-scrollbar { display: none; }
  .ct-tab {
    flex: none; cursor: pointer; white-space: nowrap; min-height: 44px;
    font: 700 13px/1 var(--font-display); border-radius: 999px; padding: 12px 16px;
    background: #fff; color: var(--text-2); border: 1.5px solid #e3e0d9;
    transition: background .15s ease, color .15s ease, border-color .15s ease;
  }
  .ct-tab:hover { border-color: var(--cat); color: var(--ink); }
  /* Active tab = the same solid category chip ClassCard puts on its media. */
  .ct-tab.on { background: var(--cat); color: #fff; border-color: var(--cat); }

  .ct-panel { display: grid; grid-template-columns: .95fr 1.05fr; align-items: stretch; }
  .ct-panel[hidden] { display: none; }

  .ct-media { position: relative; overflow: hidden; background: var(--ink); min-height: 320px; }
  .ct-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .ct-media-ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(150deg, color-mix(in srgb, var(--cat) 28%, var(--ink)), var(--ink)); }
  .ct-media-ph i { font-size: 46px; color: color-mix(in srgb, var(--cat) 60%, #fff); opacity: .85; }

  .ct-body { padding: 30px 32px 32px; display: flex; flex-direction: column; gap: 13px; }
  .ct-booking { align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 6px; background: var(--cat); color: #fff; font: 800 10.5px/1 var(--font-display); letter-spacing: .07em; text-transform: uppercase; }
  .ct-booking i { font-size: 12px; }
  .ct-title { font: 800 28px/1.08 var(--font-display); letter-spacing: -.018em; color: var(--ink); margin: 0; }
  .ct-headline { font: 700 15.5px/1.35 var(--font-display); color: color-mix(in srgb, var(--cat) 62%, #000); margin: 0; }
  .ct-desc { font: 400 14px/1.6 var(--font-body); color: var(--text-3); margin: 0; max-width: 560px; }
  .ct-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .ct-pill { font: 600 12.5px/1 var(--font-body); color: color-mix(in srgb, var(--cat) 62%, #000); background: color-mix(in srgb, var(--cat) 10%, #fff); border: 1px solid color-mix(in srgb, var(--cat) 24%, #fff); border-radius: 999px; padding: 6px 11px; white-space: nowrap; }
  .ct-specs { margin-top: auto; padding-top: 8px; display: flex; flex-direction: column; }
  .ct-spec { display: grid; grid-template-columns: max-content 1fr; gap: 14px; padding: 9px 0; border-top: 1px solid #efeee8; }
  .ct-spec-l { font: 700 10px/1.4 var(--font-display); letter-spacing: .07em; text-transform: uppercase; color: color-mix(in srgb, var(--cat) 62%, #000); white-space: nowrap; }
  .ct-spec-v { font: 600 13px/1.3 var(--font-body); color: var(--text-2); }
  .ct-act { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; margin-top: 6px; font: 800 14px/1 var(--font-display); text-transform: uppercase; letter-spacing: .03em; color: var(--ink); text-decoration: none; transition: gap .15s; }
  .ct-act:hover { gap: 11px; }
  .ct-act i { color: var(--cat); }

  /* Phone: strip on top, media above the copy. */
  .ct.compact { border-radius: var(--radius); }
  .ct.compact .ct-tabs { padding: 12px 14px; gap: 7px; }
  .ct.compact .ct-tab { font-size: 12.5px; padding: 12px 14px; }
  .ct.compact .ct-panel { grid-template-columns: 1fr; }
  .ct.compact .ct-media { min-height: 0; aspect-ratio: 16/10; }
  .ct.compact .ct-body { padding: 18px; gap: 11px; }
  .ct.compact .ct-title { font-size: 22px; }
  .ct.compact .ct-headline { font-size: 14px; }
  .ct.compact .ct-desc { font-size: 13px; }

  @media (max-width: 860px) {
    .ct-panel { grid-template-columns: 1fr; }
    .ct-media { min-height: 0; aspect-ratio: 16/10; }
    .ct-body { padding: 22px; }
    .ct-title { font-size: 24px; }
  }
</style>

<script>
  import { mountClassTabs } from '../lib/class-tabs';
  document.addEventListener('astro:page-load', () => mountClassTabs());
</script>
