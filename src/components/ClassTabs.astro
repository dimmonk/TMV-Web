---
import Priced from './Priced.astro';
/**
 * The Specialized Classes card: the class LIST, one BLOCK for what every class
 * shares, and one PANEL that changes with the selected class.
 *
 * Every class here comes from the Members schedule (`specializedView`,
 * src/lib/specialized-classes.js): a class is listed while it has sessions, and
 * its name, description, days, times and ages are the schedule's. The
 * price comes from the Members price list. Only the clips live in this repo.
 *
 * Booking, price and the action are the same for every class, so they are said
 * once in the shared block; the panel carries only what differs. A list row
 * names only the days a class runs; exact times are in the panel, and comparing
 * classes side by side is the schedule page's job, which the shared block links to.
 *
 * Live: the browser re-reads the schedule and updates the card in place
 * (lib/class-tabs.ts, lib/apply-specialized-classes.js), through the `data-class-*`
 * hooks below, which are always in the markup (`hidden` when empty).
 *
 * Sizing: the list sets the card's height. The panel's clip fills its column
 * (object-fit: cover) so the panel never leaves a hole beside it, and the
 * shared block sits under the panel.
 *
 * Content only: no chrome, no fixed width. Below `lg` everything stacks: list,
 * then the panel with its clip on top, then the shared block.
 */
import { url, cat } from '../data/site';
import { isVideoAsset, classMediaExists } from '../lib/class-media';
import type { ClassRow } from '../lib/specialized-classes.js';
import type { ClassOffer } from '../data/class-schedule';

interface Props {
  rows: ClassRow[];
  offer: ClassOffer;
}
const { rows, offer } = Astro.props;

const items = rows.map((r) => ({
  ...r,
  src: r.image.startsWith('assets/') ? url(r.image) : r.image,
  isVideo: isVideoAsset(r.image),
  hasMedia: r.image !== '' && classMediaExists(r.image),
}));
---
<div class="ct" style={`--cat:${cat.classes}`} data-class-tabs>
  <div class="ct-list" role="tablist" aria-orientation="vertical" aria-label="Specialized classes">
    {items.map((it, i) => (
      <button
        type="button" class:list={['ct-row', { on: i === 0 }]} data-class-tab={it.id}
        role="tab" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
      >
        <span class="ct-row-t">{it.name}</span>
        <span class="ct-row-days" data-class-days hidden={!it.days}>{it.days}</span>
        <i class="bi bi-chevron-right ct-row-chev" aria-hidden="true"></i>
      </button>
    ))}
  </div>

  <div class="ct-side">
    <div class="ct-detail" data-class-detail>
      {items.map((it, i) => (
        <div class="ct-panel" data-class-panel={it.id} role="tabpanel" aria-label={it.name} hidden={i !== 0}>
          <div class="ct-copy">
            <h3 class="ct-title">{it.name}</h3>
            <p class="ct-desc" data-class-body hidden={!it.body}>{it.body}</p>
            <div class="ct-facts">
              <div class="ct-spec" data-class-who-row hidden={!it.who}><span class="ct-spec-l">Who it's for</span><span class="ct-spec-v" data-class-who>{it.who}</span></div>
              <div class="ct-spec"><span class="ct-spec-l">When</span><span class="ct-spec-v" data-class-when>{it.when.map((line) => <span class="ct-when-line">{line}</span>)}</span></div>
            </div>
          </div>

          <div class="ct-media">
            {!it.hasMedia
              ? <div class="ct-media-ph" aria-hidden="true"><i class="bi bi-person-arms-up"></i></div>
              : it.isVideo
              ? <video class="ct-img" src={it.src} muted loop playsinline webkit-playsinline preload="none"></video>
              : <img class="ct-img" src={it.src} alt={it.name} loading="lazy" />}
          </div>
        </div>
      ))}
    </div>

    <div class="ct-offer">
      <p class="ct-offer-t">
        <strong>All drop-in<Priced text={`: ${offer.price}`} />.</strong> No reservation needed.
      </p>
      <a href={url('schedule')} class="btn btn-dark ct-act">
        View schedule <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div>

<style>
  .ct {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm); overflow: hidden;
    display: grid; grid-template-columns: 260px minmax(0, 1fr);
  }

  /* THE LIST: every class, readable in one glance. */
  .ct-list { display: flex; flex-direction: column; background: #faf9f6; border-right: 1px solid var(--line); padding: 8px; gap: 2px; }
  .ct-row {
    cursor: pointer; text-align: left; width: 100%; display: flex; align-items: center; gap: 10px;
    min-height: 34px; padding: 4px 10px; border-radius: 7px; border: 1px solid transparent;
    background: transparent; transition: background .15s ease, border-color .15s ease;
  }
  .ct-row:hover { background: #fff; border-color: var(--line); }
  /* Selected: a tint plus a full border, never a single-side stripe. */
  .ct-row.on { background: color-mix(in srgb, var(--cat) 11%, #fff); border-color: color-mix(in srgb, var(--cat) 34%, #fff); }
  .ct-row-t { flex: 1; min-width: 0; font: 800 13.5px/1.2 var(--font-display); letter-spacing: -.008em; color: var(--ink); }
  .ct-row-days { flex: none; font: 600 11.5px/1 var(--font-body); color: var(--muted); white-space: nowrap; }
  .ct-row.on .ct-row-t { color: color-mix(in srgb, var(--cat) 66%, #000); }
  .ct-row-chev { flex: none; font-size: 11px; color: var(--faint); opacity: 0; transition: opacity .15s ease; }
  .ct-row:hover .ct-row-chev { opacity: 1; }
  .ct-row.on .ct-row-chev { opacity: 1; color: var(--cat); }

  /* THE SIDE: the changing panel, then the block every class shares. */
  .ct-side { min-width: 0; display: flex; flex-direction: column; }
  .ct-detail { flex: 1; display: flex; min-height: 0; }
  .ct-panel { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) clamp(260px, 42%, 420px); }
  .ct-panel[hidden] { display: none; }

  .ct-copy { padding: 24px 28px 22px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .ct-title { font: 800 23px/1.06 var(--font-display); letter-spacing: -.018em; color: var(--ink); margin: 0; }
  .ct-desc { font: 400 13.5px/1.62 var(--font-body); color: var(--text-3); margin: 0; }
  .ct-facts { margin-top: 8px; }
  .ct-spec { display: grid; grid-template-columns: 96px 1fr; gap: 12px; padding: 8px 0; border-top: 1px solid #efeee8; }
  .ct-spec-l { font: 700 10px/1.4 var(--font-display); letter-spacing: .07em; text-transform: uppercase; color: color-mix(in srgb, var(--cat) 62%, #000); }
  .ct-spec-v { font: 600 13px/1.3 var(--font-body); color: var(--text-2); }
  /* Lines the browser rebuilds carry no scope attribute, hence :global. */
  .ct-spec-v :global(.ct-when-line) { display: block; }
  .ct-spec-v :global(.ct-when-line + .ct-when-line) { margin-top: 4px; }

  /* The clip FILLS its column, so the panel never leaves a hole beside it. */
  .ct-media { position: relative; background: var(--ink); overflow: hidden; min-height: 240px; }
  .ct-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .ct-media-ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(150deg, color-mix(in srgb, var(--cat) 28%, var(--ink)), var(--ink)); }
  .ct-media-ph i { font-size: 44px; color: color-mix(in srgb, var(--cat) 60%, #fff); opacity: .85; }

  /* THE SHARED BLOCK: said once, never per class. */
  .ct-offer { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 28px; background: #faf9f6; border-top: 1px solid var(--line); }
  .ct-offer-t { margin: 0; font: 400 14px/1.5 var(--font-body); color: var(--text-3); }
  .ct-offer-t strong { font-weight: 700; color: var(--ink); }
  .ct-act { flex: none; min-height: 44px; }

  /* Stacked: list, then the panel with its clip on top, then the shared block. */
  @media (max-width: 1023px) {
    .ct { grid-template-columns: 1fr; }
    .ct-list { border-right: 0; border-bottom: 1px solid var(--line); }
    .ct-row-chev { opacity: 1; }
    .ct-row { min-height: 44px; }
    .ct-panel { grid-template-columns: 1fr; }
    .ct-media { order: -1; min-height: 0; aspect-ratio: 16/11; max-height: 380px; }
    .ct-copy { padding: 20px; }
    .ct-offer { flex-wrap: wrap; padding: 16px 20px; }
  }
</style>

<script>
  import { mountClassTabs } from '../lib/class-tabs';
  document.addEventListener('astro:page-load', () => mountClassTabs());
</script>
