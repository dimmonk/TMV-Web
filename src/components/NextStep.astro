---
/**
 * The page's closing next step — ONE quiet line, never a banner.
 *
 * This started as a dark band and was cut back: three banners on Train alone
 * added more page than the guidance was worth. It is now a single bordered row
 * — a sentence and a link — so a page can end with a recommendation without
 * gaining a whole block. One per page is the cap; see `nextSteps` in
 * src/data/progression.ts for why.
 *
 * Content only — no width, no container.
 */
import { nextSteps, type NextStepKey } from '../data/progression';

interface Props { step: NextStepKey; }
const { step } = Astro.props;
const s = nextSteps[step];
---
<div class="ns">
  <i class={`bi ${s.icon} ns-ic`} aria-hidden="true"></i>
  <p class="ns-txt">{s.text}</p>
  <a href={s.href} {...(s.external ? { target: '_blank', rel: 'noopener' } : {})} class="ns-cta">
    {s.cta} <i class={`bi ${s.external ? 'bi-arrow-up-right' : 'bi-arrow-right'}`} aria-hidden="true"></i>
  </a>
</div>

<style>
  .ns { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 20px; }
  .ns-ic { flex: none; font-size: 17px; color: var(--brand); }
  .ns-txt { flex: 1; min-width: 200px; font: 500 14px/1.5 var(--font-body); color: var(--text-2); margin: 0; }
  .ns-cta { flex: none; display: inline-flex; align-items: center; gap: 7px; min-height: 44px; font: 800 12.5px/1 var(--font-display); text-transform: uppercase; letter-spacing: .03em; color: var(--ink); text-decoration: none; white-space: nowrap; transition: gap .15s ease; }
  .ns-cta:hover { gap: 10px; }
  .ns-cta i { color: var(--brand); }

  @media (max-width: 560px) { .ns { gap: 10px; padding: 14px 16px; } }
</style>
