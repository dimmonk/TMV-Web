---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import MobileHero from '../components/MobileHero.astro';
import PurchaseFit from '../components/PurchaseFit.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { seo, links, url } from '../data/site';
import { sq } from '../data/square-links';
import '../styles/price-list-sheet.css';

// Category shortcuts into the live list, and the one action each category leads to. The keys are the price
// list's own section titles (the renderer prints them), so a renamed section simply loses its shortcut.
const categories = [
  { key: 'classes', label: 'Classes', title: 'Classes', action: { href: sq.store.classPasses, label: 'Buy class passes', ext: true } },
  { key: 'opengym', label: 'Open Gym', title: 'Open Gym', action: { href: sq.store.dayPasses, label: 'Buy open gym passes', ext: true } },
  { key: 'intro', label: 'Intro Lesson', title: 'Introduction Class', action: { href: sq.getStarted.introduction, label: 'Book an intro lesson', ext: true } },
  { key: 'private', label: 'Private Lessons', title: 'Private Classes', action: { href: sq.privateLessons.privateLesson, label: 'Book a private lesson', ext: true } },
  { key: 'athletic', label: 'Athletic', title: 'Athletic Program', action: { href: url('athletic-program'), label: 'See the program' } },
  { key: 'parties', label: 'Birthday Parties', title: 'Birthday Party', action: { href: url('events'), label: 'Compare party packages' } },
  { key: 'camps', label: 'Camps', title: 'Camps', action: { href: url('camps'), label: 'See camp dates' } },
];
---
<BaseLayout title={seo.pricing.title} description={seo.pricing.description} active="pricing" mobileTab="more" appHeader="back" appTitle="Pricing">
  <div class="mapp" data-chrome="app">
    <MobileHero eyebrow="Pricing" title="One price list" desc="Live from our booking system — buy before you arrive and skip the front-desk line." />
    {/* Value before price: four buyer profiles, then the numbers. */}
    <div class="m-pad">
      <a class="m-brandbtn pl-jump" href="#prices">Jump to prices <i class="bi bi-arrow-down" aria-hidden="true"></i></a>
      <h3 class="m-h3">Which one is you?</h3>
      <p class="m-sub">Find yourself here first — the prices make more sense after.</p>
      <PurchaseFit />
    </div>
  </div>

  <section class="pagehero" data-chrome="site">
    <div class="pagehero-glow"></div>
    <div class="container pagehero-inner">
      <div class="pagehero-kicker"><span class="rule"></span>Passes, packs &amp; memberships</div>
      <h1 class="pagehero-title">One price list. Buy before you arrive.</h1>
      <p class="pagehero-lead">Every option below is live from our booking system and checks out securely in our online store. Set up your pass before you get to the gym and skip the front-desk line.</p>
      <div style="margin-top:24px; display:flex; gap:12px; flex-wrap:wrap">
        <a href="#prices" class="btn btn-primary">Jump to prices <i class="bi bi-arrow-down" aria-hidden="true"></i></a>
        <a href={url('store')} class="btn btn-ghost-light">Buy passes &amp; memberships</a>
      </div>
      <p class="pagehero-fine">All prices in CAD, HST included. Pre-paid packs are valid 10–20 months depending on size.</p>
    </div>
  </section>

  {/* MATCH THE PURCHASE TO THE GOAL — value before price (data/progression.ts) */}
  <section class="container pl-fit" data-chrome="site">
    <div class="pl-fit-head">
      <SectionHeader num="01" eyebrow="Before the price list" title="Which one is you?" description="Four kinds of people buy passes here. Find yours — the price makes a lot more sense once you know what you're getting." />
    </div>
    <PurchaseFit />
    <p class="pl-fit-foot">New and want the basics? <a href={sq.getStarted.introduction} target="_blank" rel="noopener">Book an intro lesson</a>. Working on one skill? <a href={sq.privateLessons.privateLesson} target="_blank" rel="noopener">Book a private lesson</a>.</p>
  </section>

  <!-- LIVE PRICE LIST — production renderer running natively (no iframe).
       Same price-list-renderer.js + price-list-sheet.css the members app
       uses; data from the public price-list projection (SSOT, read through
       fetchPublicPriceList in src/lib/public-projections.js). -->
  <main class="pl-main">
    <section id="prices" class="pl-cats" aria-labelledby="pl-cats-title">
      <h2 id="pl-cats-title" class="pl-cats-title">Prices by activity</h2>
      <nav class="pl-cats-nav" aria-label="Price categories">{categories.map((c) => <a href={`#price-${c.key}`}>{c.label}</a>)}</nav>
      <p class="pl-cats-note">Group classes and open gym are drop-in, no booking. Intro and private lessons are booked ahead. Each section ends with where to buy or book it.</p>
    </section>
    <div class="pl-embed-shell">
      <div class="pl-embed-desktop">
        <div id="pl-embed-root" data-categories={JSON.stringify(categories)}></div>
      </div>
    </div>

    <p class="pl-foot">
      <i class="bi bi-arrow-repeat" aria-hidden="true"></i>&nbsp; Prices update automatically from our booking system — this is the same list our front desk prints.
    </p>

    <!-- STORE CTA — where purchase intent peaks -->
    <section class="pl-cta">
      <CtaBand cards={[
        { theme: 'dark', eyebrow: 'Buy before you arrive', title: 'Passes & memberships — online store', icon: 'bi-bag-check-fill', href: url('store') },
        { theme: 'light', eyebrow: 'Booking a time instead?', title: 'Book a session', icon: 'bi-calendar-check', href: url('book') },
      ]} />
    </section>

    <!-- GIFT CARDS -->
    <section class="pl-gift-wrap">
      <a href={links.giftCard} target="_blank" rel="noopener" class="pl-gift">
        <div class="pl-gift-lead">
          <span class="pl-gift-icon"><i class="bi bi-gift-fill" aria-hidden="true"></i></span>
          <div>
            <div class="pl-gift-eyebrow">The easy gift</div>
            <div class="pl-gift-title">Gift cards — any amount</div>
          </div>
        </div>
        <span class="btn btn-primary pl-gift-btn">Buy a gift card <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>

  .pl-fit { max-width: 1168px; padding-block: 52px 8px; }
  .pl-fit-head { margin-bottom: 28px; }
  .pl-fit-foot { font: 500 13.5px/1.5 var(--font-body); color: var(--muted); margin-top: 18px; }
  .pl-fit-foot a { font-weight: 700; color: var(--ink); text-decoration: none; border-bottom: 2px solid var(--brand); }

  .pl-main { max-width: 1440px; margin: 0 auto; padding: 28px 20px 24px; }
  .pl-jump { margin-bottom: 26px; }
  .pl-cats { max-width: 1168px; margin: 0 auto 18px; scroll-margin-top: 90px; }
  .pl-cats-title { font: 800 26px/1.15 var(--font-display); letter-spacing: -.01em; }
  .pl-cats-nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 12px; }
  .pl-cats-nav a { padding: 10px 14px; border-radius: 999px; background: var(--ink); color: #fff; text-decoration: none; font: 700 12px/1.2 var(--font-display); }
  .pl-cats-note { font: 500 13px/1.6 var(--font-body); color: var(--muted); max-width: 760px; }
  .pl-foot { font: 500 12.5px/1.5 var(--font-body); color: #9b9890; text-align: center; margin: 16px 0 44px; }
  .pl-foot i { color: var(--brand); }
  .pl-cta { max-width: 1120px; margin: 0 auto 44px; }

  .pl-gift-wrap { max-width: 1120px; margin: 0 auto 8px; }
  .pl-gift {
    text-decoration: none; display: flex; align-items: center; justify-content: space-between; gap: 20px;
    flex-wrap: wrap; background: var(--ink); color: #fff; border-radius: 18px; padding: 34px 38px;
  }
  .pl-gift-lead { display: flex; align-items: center; gap: 18px; }
  .pl-gift-icon {
    flex: none; width: 52px; height: 52px; border-radius: 14px; background: rgba(255,255,255,.1);
    display: flex; align-items: center; justify-content: center; font-size: 24px; color: var(--brand);
  }
  .pl-gift-eyebrow { font: 700 11px/1 var(--font-display); letter-spacing: .13em; text-transform: uppercase; color: var(--brand); margin-bottom: 8px; }
  .pl-gift-title { font: 800 24px/1.05 var(--font-display); letter-spacing: -.012em; }
  .pl-gift-btn { flex: none; }
</style>
<style is:global>
  #pl-embed-root .ed-card { scroll-margin-top: 90px; }
  .pl-cat-action { display: block; clear: both; text-decoration: none; font: 800 12px/1.4 var(--font-display); margin-top: 16px; border-top: 1px solid currentColor; padding: 14px 0 4px; color: var(--ink); }
</style>

<script>
  import { renderPriceListSheet } from '../lib/price-list-renderer.js';
  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('pl-embed-root');
    if (!root) return;
    renderPriceListSheet(root)
      .then(() => {
        // The sheet renders as a standalone document, so it titles itself with an
        // <h1> — correct for the printed PDF, a second <h1> on this page. Demote
        // them here rather than forking price-list-renderer.js, which is
        // byte-identical with TMV-Members' copy.
        root.querySelectorAll('h1').forEach((h) => {
          const h2 = document.createElement('h2');
          h2.className = h.className;
          h2.append(...h.childNodes);
          h.replaceWith(h2);
        });
        // Each category gets an anchor for the shortcuts above and ends with its one action.
        const categories = JSON.parse(root.dataset.categories || '[]');
        root.querySelectorAll<HTMLElement>('.ed-card').forEach((card) => {
          const title = card.querySelector('.ed-title')?.textContent?.trim();
          const cat = categories.find((c: { title: string }) => c.title === title);
          if (!cat) return;
          card.id = `price-${cat.key}`;
          const a = document.createElement('a');
          a.className = 'pl-cat-action';
          a.href = cat.action.href;
          a.textContent = `${cat.action.label} →`;
          if (cat.action.ext) { a.target = '_blank'; a.rel = 'noopener'; }
          card.append(a);
        });
        const target = decodeURIComponent(location.hash.slice(1));
        if (target) document.getElementById(target)?.scrollIntoView({ block: 'start' });
      })
      .catch((err) => console.error('[pricing] render failed', err));
  });
</script>
