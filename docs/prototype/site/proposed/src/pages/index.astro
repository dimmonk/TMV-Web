---
import Priced from '../components/Priced.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ActivityLinks from '../components/ActivityLinks.astro';
import VisitSummary from '../components/VisitSummary.astro';
import GoalPicker from '../components/GoalPicker.astro';
import Reviews from '../components/Reviews.astro';
import ScheduleChanges from '../components/ScheduleChanges.astro';
import SpecialEvents from '../components/SpecialEvents.astro';
import Words from '../components/Words.astro';
import { seo, cat, url } from '../data/site';
import { contact } from '../data/site-config';
import { heroStats } from '../data/hero-stats';
import { bookableSeasons, campByKey } from '../data/camps';

const paDay = campByKey('paday')!;

const heroPhotos = [
  'gym-01.jpg', 'gym-02.jpg', 'gym-03.jpg', 'gym-04.jpg',
  'gym-05.jpg', 'gym-06.jpg', 'gym-07.jpg', 'gym-08.jpg',
].map((f) => url(`assets/${f}`));

/* Built from `weeklySeasons`, not hardcoded: the old card said "Summer Camps
   2026" all year round, so it was wrong every autumn. Flip a season's
   `bookable` in data/camps.ts and this band follows. */
const camps = [
  ...bookableSeasons().map((s) => ({
    title: s.label, badge: s.badge, color: cat.camps, status: 'Booking now', statusColor: cat.openGym,
    price: s.price, cta: 'See dates', href: `${url('camps')}#dates`, external: false,
    rows: [
      { icon: 'bi-calendar-week', text: s.when },
      { icon: 'bi-clock', text: '9 AM – 2 PM · late pickup to 4 PM' },
      { icon: 'bi-people', text: 'Ages 5 to 16 · all levels' },
    ],
  })),
  {
    title: 'P.A. Day Camps', badge: 'School year', color: cat.camps, status: 'Single days', statusColor: cat.classes,
    price: paDay.price, cta: paDay.cta, href: paDay.href.startsWith('#') ? `${url('camps')}${paDay.href}` : paDay.href, external: !paDay.href.startsWith('#'),
    rows: [
      { icon: 'bi-sun', text: 'Single days off school' },
      { icon: 'bi-clock', text: '9 AM – 2 PM · late pickup to 4 PM' },
      { icon: 'bi-unlock', text: 'Open to the public' },
    ],
  },
];
---
<BaseLayout title={seo.home.title} description={seo.home.description} active="" mobileTab="home">

  <!-- HERO -->
  <section class="hero" id="top">
    <div class="hero-glow"></div>
    <div class="hero-inner container">
      <div>
        <div class="hero-kicker"><span class="hero-kicker-rule"></span><Words full="Parkour & Movement Training Centre · Toronto" short="Parkour & movement · Toronto" /></div>
        <h1 class="hero-title">Come to play.<br>Stay to learn.</h1>
        <p class="hero-lead">Toronto's home for parkour, flips and movement. Open gym, coached classes, camps and birthday parties — every age, every level, under one big roof.</p>
        <div class="hero-actions">
          <a href="#start" class="btn btn-primary">Find your starting point <i class="bi bi-arrow-down" aria-hidden="true"></i></a>
        </div>
        <div class="hero-stats">
          {heroStats.map((st, i) => (
            <div class:list={['hero-stat', { last: i === heroStats.length - 1 }]} data-hours-stat={st.hours ? '' : undefined} data-stat-variant={st.hours ? 'desktop' : undefined} hidden={st.hidden}><div class="hero-statnum" data-stat-value={st.hours ? '' : undefined}><Priced text={st.value} /></div><div class="hero-statlabel">{st.mobileLabel
              ? <><span class="w-full" data-stat-label={st.hours ? '' : undefined}>{st.label}</span><span class="w-short" data-stat-label={st.hours ? 'short' : undefined}>{st.mobileLabel}</span></>
              : <span data-stat-label={st.hours ? '' : undefined}>{st.label}</span>}</div></div>
          ))}
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-frame" id="hero-carousel">
          {heroPhotos.map((src, i) => (
            i === 0
              ? <div class="hero-slide" style={`background-image:url('${src}'); opacity:1`}></div>
              : <div class="hero-slide" data-bg={src} style="opacity:0"></div>
          ))}
        </div>
        <div class="hero-badge" data-contact-wrap="address" hidden={!contact.street}><span data-contact="street">{contact.street}</span><br>Downsview Park</div>
      </div>
    </div>
  </section>

  <!-- GOAL PICKER, first after the hero: a visitor picks their goal before anything else. ASK → RECOMMEND → REASON → INVITE (see data/goals.ts) -->
  <section id="start" class="section container goalsec">
    <div class="goalsec-head">
      <SectionHeader num="01" eyebrow="Where to start" title="What are you here for?" />
    </div>
    <GoalPicker />
  </section>

  <!-- SCHEDULE CHANGES: staff's cancelled dates and closed days, shown only while there are any -->
  <div class="container home-changes"><ScheduleChanges /></div>

  <!-- SPECIAL EVENTS: staff's public happenings, shown only while one is coming up -->
  <div class="container home-events">
    <SpecialEvents id="special-events">
      <div slot="head" class="home-events-head"><SectionHeader eyebrow="Coming up" title="Special events" color={cat.parties} /></div>
    </SpecialEvents>
  </div>

  <!-- OFFERINGS -->
  <section id="offerings" class="section container offerings">
    <div class="offerings-head">
      <SectionHeader num="02" eyebrow="Or browse" title="Four ways to get moving" />
    </div>
    <ActivityLinks />
  </section>

  <!-- CAMPS BAND -->
  <section id="camps" class="camps-band">
    <div class="container">
      <div class="camps-head">
        <div>
          <div class="camps-eyebrow">03 — School breaks &amp; days off</div>
          <h2 class="camps-title">Camps booking now</h2>
          <p class="camps-lead">School breaks and P.A. Days, ages 5 to 16.</p>
        </div>
        <a href={url('camps')} class="camps-all">All camps <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <div class="camps-grid">
        {camps.map((c) => (
          <div class="camp-card">
            <div class="camp-strip" style={`background:${c.color}`}></div>
            <div class="camp-body">
              <div class="camp-top">
                <span class="camp-badge" style={`background:${c.color}`}>{c.badge}</span>
                <span class="camp-status" style={`color:${c.statusColor}`}><span class="dot" style={`background:${c.statusColor}`}></span>{c.status}</span>
              </div>
              <h3 class="camp-title">{c.title}</h3>
              <div class="camp-rows">
                {c.rows.map((r) => (
                  <div class="camp-row"><i class={`bi ${r.icon}`} style={`color:${c.color}`} aria-hidden="true"></i>{r.text}</div>
                ))}
              </div>
              <div class="camp-foot">
                <span class="camp-price" style={`color:${c.color}`}><Priced text={c.price} /></span>
                <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined} class="camp-resv">{c.cta} <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Reviews eyebrow="04 — What people say" />

  <section class="section container final-cta">
    <VisitSummary />
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero { background: var(--ink); color: #fff; position: relative; overflow: hidden; }
  .hero-glow { position: absolute; inset: 0; background: radial-gradient(680px 360px at 90% -12%, rgba(255,212,0,.13), transparent 70%); }
  .hero-inner { padding-block: 66px 30px; display: grid; grid-template-columns: 1.05fr .95fr; gap: 50px; align-items: center; position: relative; }
  .hero-kicker { display: inline-flex; align-items: center; gap: 9px; font: 700 12px/1 var(--font-display); letter-spacing: .14em; text-transform: uppercase; color: var(--brand); margin-bottom: 22px; }
  .hero-kicker-rule { width: 22px; height: 2px; background: var(--brand); }
  .hero-title { font: 800 clamp(40px, 9.5vw, 60px)/1 var(--font-display); letter-spacing: -.022em; margin-bottom: 20px; text-wrap: balance; }
  .hero-lead { font: 400 16px/1.55 var(--font-body); color: rgba(255,255,255,.72); max-width: 470px; margin-bottom: 32px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .hero-actions .btn { padding: 16px 26px; font-size: 15px; border-radius: 12px; }
  .hero-stats { display: flex; flex-wrap: wrap; margin-top: 36px; border-top: 1px solid rgba(255,255,255,.12); }
  .hero-stat { padding: 20px 28px 0 0; margin-right: 28px; border-right: 1px solid rgba(255,255,255,.12); }
  .hero-stat.last { border-right: 0; margin-right: 0; padding-right: 0; }
  .hero-statnum { font: 800 26px/1 var(--font-display); color: var(--brand); }
  .hero-statlabel { font: 600 12.5px/1.3 var(--font-body); color: rgba(255,255,255,.6); margin-top: 6px; }
  .hero-media { position: relative; }
  .hero-frame { position: relative; aspect-ratio: 5/4; border-radius: 18px; overflow: hidden; box-shadow: 0 30px 60px -25px rgba(0,0,0,.7); border: 3px solid rgba(255,255,255,.08); background: #2a2724; }
  .hero-slide { position: absolute; inset: 0; background-size: cover; background-position: center; transition: opacity 1s ease; }
  .hero-badge { position: absolute; bottom: -16px; right: -10px; background: var(--brand); color: var(--ink); font: 800 13px/1.2 var(--font-display); text-transform: uppercase; letter-spacing: .03em; padding: 13px 16px; border-radius: 12px; box-shadow: 0 12px 30px -10px rgba(0,0,0,.5); }

  /* BOOK STRIP */
  .bookstrip { background: var(--ink); }
  .bookstrip-inner { padding-bottom: 26px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .bookstrip-inner > i { font-size: 20px; color: var(--brand); }
  .bookstrip-inner span { font: 600 14px/1.6 var(--font-body); color: rgba(255,255,255,.7); }
  .bookstrip-inner a { margin-left: auto; font: 800 13px/1 var(--font-display); text-transform: uppercase; letter-spacing: .04em; color: var(--brand); text-decoration: none; display: inline-flex; align-items: center; gap: 7px; }

  /* SCHEDULE CHANGES (the card lives in ScheduleChanges.astro) */
  .home-changes { --sched-changes-pad: 36px 0 0; }
  .home-events { --site-events-pad: 52px 0 0; }
  .home-events-head { margin-bottom: 24px; }

  /* GOAL PICKER (the picker itself lives in GoalPicker.astro) */
  .goalsec { scroll-margin-top: 80px; padding-block: 52px 40px; }
  .goalsec-head { margin-bottom: 26px; }

  /* OFFERINGS (flip cards live in OfferingCard.astro) */
  .offerings { scroll-margin-top: 80px; padding-block: 40px 56px; }
  .offerings-head { margin-bottom: 26px; }

  /* CAMPS BAND */
  .camps-band { background: var(--ink); color: #fff; }
  .camps-band .container { padding-block: 48px; }
  .camps-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 26px; }
  .camps-eyebrow { font: 700 12px/1 var(--font-display); letter-spacing: .14em; text-transform: uppercase; color: var(--brand); margin-bottom: 12px; }
  .camps-title { font: 800 clamp(28px,5vw,36px)/1.04 var(--font-display); letter-spacing: -.018em; margin-bottom: 8px; }
  .camps-lead { font: 400 15px/1.55 var(--font-body); color: rgba(255,255,255,.66); max-width: 540px; }
  .camps-all { font: 800 13px/1 var(--font-display); text-transform: uppercase; letter-spacing: .04em; color: var(--brand); text-decoration: none; display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
  .camps-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 18px; }
  .camp-card { display: flex; flex-direction: column; background: #fff; color: var(--ink); border-radius: 16px; overflow: hidden; box-shadow: 0 18px 44px -28px rgba(0,0,0,.6); }
  .camp-strip { height: 5px; }
  .camp-body { padding: 24px 26px 26px; display: flex; flex-direction: column; flex: 1; }
  .camp-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
  .camp-badge { font: 700 10px/1 var(--font-display); letter-spacing: .08em; text-transform: uppercase; color: #fff; padding: 6px 10px; border-radius: 999px; }
  .camp-status { display: inline-flex; align-items: center; gap: 6px; font: 700 11px/1 var(--font-display); letter-spacing: .04em; text-transform: uppercase; }
  .camp-status .dot { width: 7px; height: 7px; border-radius: 50%; }
  .camp-title { font: 800 22px/1.1 var(--font-display); letter-spacing: -.01em; margin-bottom: 16px; }
  .camp-rows { display: flex; flex-direction: column; gap: 10px; margin-bottom: 18px; }
  .camp-row { display: flex; align-items: flex-start; gap: 10px; font: 600 14px/1.6 var(--font-body); color: var(--text-2); }
  .camp-row i { margin-top: 2px; flex: none; }
  .camp-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 16px; border-top: 1px solid var(--line-soft); }
  .camp-price { font: 800 18px/1 var(--font-display); }
  .camp-resv { display: inline-flex; align-items: center; gap: 8px; background: var(--ink); color: #fff; font: 800 12.5px/1 var(--font-display); text-transform: uppercase; letter-spacing: .03em; text-decoration: none; padding: 12px 18px; border-radius: 10px; transition: gap .18s ease; }
  .camp-resv:hover { gap: 11px; }

  .final-cta { padding-block: 32px 64px; }

  /* RESPONSIVE: below desktop the headline leads and the photo follows it (a phone or a portrait tablet must not open
     on a screen of photo); at 1024 and up the two sit side by side, as above. */
  @media (max-width: 1023px) {
    .hero-inner { grid-template-columns: 1fr; gap: 36px; padding-block: 44px 40px; }
    .hero-frame { aspect-ratio: 16/9; }
    .hero-badge { right: 12px; }
  }
  /* PHONE: the app home's compact hero (no photo, one button, the three numbers in one row), the sections as
     headed rows on the page background, the camp cards stacked. */
  @media (max-width: 767px) {
    .hero-inner { padding-block: 24px 26px; gap: 0; }
    .hero-media { display: none; }
    .hero-kicker { font-size: 12px; letter-spacing: .12em; gap: 8px; margin-bottom: 18px; }
    .hero-kicker-rule { width: 18px; }
    .hero-title { font-size: 34px; line-height: 1.02; letter-spacing: -.02em; margin-bottom: 14px; }
    .hero-lead { margin-bottom: 22px; }
    .hero-actions .btn { width: 100%; justify-content: center; padding: 14px; font-size: 14px; min-height: 48px; }
    .hero-stats { flex-wrap: nowrap; margin-top: 22px; padding-top: 16px; }
    .hero-stat { flex: 1; min-width: 0; padding: 0 8px; margin: 0; text-align: center; }
    .hero-stat:first-child { padding-left: 0; text-align: left; }
    .hero-stat.last { padding-right: 0; text-align: right; }
    .hero-statnum { font-size: 20px; }
    .hero-statlabel { font-size: 12px; margin-top: 5px; }
    .goalsec { padding-block: 32px 24px; }
    .goalsec-head { margin-bottom: 16px; }
    .offerings { padding-block: 24px 32px; }
    .offerings-head { margin-bottom: 16px; }
    .camps-band { background: transparent; color: var(--ink); }
    .camps-band .container { padding-block: 8px 32px; }
    .camps-head { flex-wrap: nowrap; align-items: center; gap: 12px; margin-bottom: 14px; }
    .camps-eyebrow { display: none; }
    .camps-title { font-size: 22px; margin-bottom: 6px; }
    .camps-lead { color: var(--muted); font-size: 15px; }
    .camps-all { color: var(--ink); font-size: 12px; min-height: 44px; align-self: flex-start; }
    .camps-grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .camp-card { border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
    .camp-body { padding: 18px 18px 18px; }
    .camp-title { font-size: 20px; margin-bottom: 12px; }
    .camp-resv { min-height: 44px; }
    .final-cta { padding-block: 16px 40px; }
  }
</style>

<script>
  // Hero photo carousel: cross-fade every 4s. Re-inits per view-transition nav;
  // the rotation interval is guarded/cleared so navs don't stack timers.
  document.addEventListener('astro:page-load', () => {
    if ((window as any).__heroTimer) { clearInterval((window as any).__heroTimer); (window as any).__heroTimer = null; }
    const carousel = document.getElementById('hero-carousel');
    if (!carousel) return;
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.hero-slide'));
    // Hydrate the other slides' backgrounds now (page-load means the page is ready).
    slides.forEach((s) => {
      const bg = s.getAttribute('data-bg');
      if (bg) { s.style.backgroundImage = `url('${bg}')`; s.removeAttribute('data-bg'); }
    });
    let idx = 0;
    if (slides.length > 1) {
      (window as any).__heroTimer = setInterval(() => {
        slides[idx].style.opacity = '0';
        idx = (idx + 1) % slides.length;
        slides[idx].style.opacity = '1';
      }, 4000);
    }
  });
</script>
