---
/**
 * Special events staff list in the members app (TMV-Members ADR-0275): one price-list card per event, drawn in the
 * browser by `applySiteEvents` (src/lib/site-events.js) from the published site config, so a staff save shows with
 * no release and a past event drops off by itself. Hidden until there is an event, heading included, so a quiet
 * month shows nothing.
 *
 * `variant="list"` is the Events page's section (every event; the page passes its heading in the `head` slot and
 * its `id`, one per chrome since both are in the page); `variant="next"` is the home card (the next few, and
 * `href`, the way to that section). Content only, width-agnostic
 * (THE RULE): the page gives it a column, and the space around it through `--site-events-pad` (applied only while
 * it shows).
 */
import '../styles/price-list-web.css';
import '../styles/site-events.css';

type Props = { variant?: 'list'; id: string } | { variant: 'next'; href: string };
const props = Astro.props;
---
{props.variant !== 'next' ? (
  <section class="se" id={props.id} data-site-events="list" hidden aria-label="Special events">
    <slot name="head" />
    <div class="pw-grid se-grid" data-site-events-cards></div>
  </section>
) : (
  <div class="se se-next" data-site-events="next" data-events-href={props.href} hidden></div>
)}

<script>
  import { applySiteEvents } from '../lib/site-events.js';
  import { publishedSiteConfig } from '../lib/live-site-config';
  import { gymNow } from '../lib/gym-clock.js';
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('[data-site-events]')) return;
    void publishedSiteConfig().then((config) => applySiteEvents(document, config.events, gymNow().wall.slice(0, 10)));
  });
</script>
