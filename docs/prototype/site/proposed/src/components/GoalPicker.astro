---
import Priced from './Priced.astro';
/**
 * "What are you here for?" — the site's ASK → RECOMMEND → REASON → INVITE
 * entry point, from the client-progression procedure. One goal in, ONE
 * recommendation out (with the reason, the price and where it leads next) —
 * deliberately not a menu of every program.
 *
 * The goals are tabs, so they look like the site's other tabs: the Specialized
 * Classes list/detail card (ClassTabs). Each goal is one short row in a list (just
 * the goal, so the reader finds theirs at a glance); the selected row is tinted in
 * the goal's colour and its recommendation sits beside the list. On a phone the recommendation opens right under the
 * goal that was tapped, so the answer is never off screen.
 *
 * One markup at every width: each row is followed by its panel, and the grid
 * places the panels beside the list from 768px up. Content only, no chrome and
 * no fixed width. Logic is src/lib/goal-picker.ts; every panel is
 * server-rendered and the first one is visible without JS.
 */
import { goals } from '../data/goals';
---
<div class="gp" data-goal-picker role="tablist" aria-orientation="vertical" aria-label="What are you here for?" style={`--n:${goals.length}`}>
  {goals.map((g, i) => (
    <>
      <button
        type="button" class:list={['gp-row', { on: i === 0 }]} data-goal-chip={g.id} style={`--cat:${g.color};--r:${i + 1}`}
        id={`gp-tab-${g.id}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`gp-panel-${g.id}`} tabindex={i === 0 ? 0 : -1}
      >
        <span class="gp-row-t">{g.label}</span>
        <i class="bi bi-chevron-right gp-row-chev" aria-hidden="true"></i>
      </button>

      <div class:list={['gp-card', { on: i === 0 }]} data-goal-panel={g.id} id={`gp-panel-${g.id}`} role="tabpanel" aria-labelledby={`gp-tab-${g.id}`} hidden={i !== 0}>
        <div class="gp-main">
          <div class="gp-eyebrow" style={`color:${g.color}`}><span class="gp-dot" style={`background:${g.color}`}></span>{g.eyebrow}</div>
          <h3 class="gp-title">{g.title}</h3>
          <p class="gp-reason">{g.reason}</p>
          <div class="gp-actions">
            <a href={g.href} {...(g.external ? { target: '_blank', rel: 'noopener' } : {})} class="btn btn-primary">
              {g.cta} <i class={`bi ${g.external ? 'bi-arrow-up-right' : 'bi-arrow-right'}`} aria-hidden="true"></i>
            </a>
            <span class="gp-price"><Priced text={g.price} /></span>
          </div>
          <p class="gp-alt">{g.altLead} <a href={g.altHref}>{g.altLink}</a></p>
        </div>

        <div class="gp-side">
          <div class="gp-side-label">{g.sideLabel}</div>
          {g.leads.map((l) => (
            <a class="gp-lead" href={l.href}>
              <span class="gp-lead-ic" style={`background:color-mix(in srgb,${l.color} 13%,#fff); color:${l.color}`}><i class="bi bi-chevron-right" aria-hidden="true"></i></span>
              <span><span class="gp-lead-t">{l.title}</span><span class="gp-lead-s">{l.sub}</span></span>
            </a>
          ))}
        </div>
      </div>
    </>
  ))}
</div>

<style>
  /* One card: the goal list on the left, the open recommendation beside it (ClassTabs' list/detail). */
  .gp {
    position: relative; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm); overflow: hidden;
    display: grid; grid-template-columns: 280px minmax(0, 1fr);
    grid-template-rows: repeat(var(--n), min-content) 1fr; align-content: start;
  }
  /* The list's own background, behind every row (the rows sit in column 1, one per grid row). */
  .gp::before { content: ''; grid-column: 1; grid-row: 1 / -1; background: #faf9f6; border-right: 1px solid var(--line); }

  /* THE LIST: every goal, with what we'd recommend under it. Same row as ClassTabs' .ct-row. */
  .gp-row {
    grid-column: 1; grid-row: var(--r); position: relative; margin: 0 8px; cursor: pointer; text-align: left; display: flex; align-items: center; gap: 10px;
    min-height: 48px; padding: 8px 12px; border-radius: 9px; border: 1px solid transparent;
    background: transparent; transition: background .15s ease, border-color .15s ease;
  }
  .gp-row:first-of-type { margin-top: 8px; }
  .gp-row:hover { background: #fff; border-color: var(--line); }
  /* Selected: a tint plus a full border in the goal's colour, never a single-side stripe. */
  .gp-row.on { background: color-mix(in srgb, var(--cat) 11%, #fff); border-color: color-mix(in srgb, var(--cat) 34%, #fff); }
  .gp-row-t { flex: 1; min-width: 0; font: 800 15px/1.25 var(--font-display); letter-spacing: -.008em; color: var(--ink); }
  .gp-row.on .gp-row-t { color: color-mix(in srgb, var(--cat) 66%, #000); }
  .gp-row-chev { flex: none; font-size: 12px; color: var(--faint); opacity: 0; transition: opacity .15s ease, transform .2s ease; }
  .gp-row:hover .gp-row-chev { opacity: 1; }
  .gp-row.on .gp-row-chev { opacity: 1; color: var(--cat); }

  /* THE DETAIL: the open recommendation, beside the whole list. */
  .gp-card { grid-column: 2; grid-row: 1 / -1; min-width: 0; display: grid; grid-template-columns: 1.25fr .75fr; }
  .gp-card[hidden] { display: none; }

  .gp-main { padding: 32px 36px 34px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .gp-eyebrow { display: inline-flex; align-items: center; gap: 9px; font: 700 12px/1 var(--font-display); letter-spacing: .14em; text-transform: uppercase; }
  .gp-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .gp-title { font: 800 28px/1.08 var(--font-display); letter-spacing: -.018em; color: var(--ink); }
  .gp-reason { font: 400 15px/1.6 var(--font-body); color: var(--text-2); max-width: 560px; }
  .gp-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 6px; }
  .gp-price { font: 800 15px/1 var(--font-display); color: var(--ink); }
  .gp-alt { font: 600 13.5px/1.4 var(--font-body); color: var(--muted); }
  .gp-alt a { font-weight: 700; color: var(--ink); text-decoration: none; border-bottom: 2px solid var(--brand); }

  .gp-side { border-left: 1px solid var(--line); padding: 30px 26px; display: flex; flex-direction: column; gap: 14px; }
  .gp-side-label { font: 700 11px/1 var(--font-display); letter-spacing: .13em; text-transform: uppercase; color: var(--muted-3); }
  .gp-lead { display: flex; align-items: center; gap: 12px; min-height: 44px; text-decoration: none; color: inherit; }
  .gp-lead-ic { flex: none; width: 32px; height: 32px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 13px; }
  .gp-lead-t { display: block; font: 800 14.5px/1.2 var(--font-display); color: var(--ink); }
  .gp-lead-s { display: block; font: 500 12.5px/1.45 var(--font-body); color: var(--muted); margin-top: 3px; }
  .gp-lead:hover .gp-lead-t { text-decoration: underline; }

  /* Narrower detail column: the "where it leads" part goes under the recommendation. */
  @media (max-width: 1279px) {
    .gp-card { grid-template-columns: 1fr; }
    .gp-side { border-left: 0; border-top: 1px solid var(--line); padding: 20px 36px 24px; }
  }
  @media (max-width: 1023px) {
    .gp { grid-template-columns: 240px minmax(0, 1fr); }
    .gp-main { padding: 24px 24px 26px; }
    .gp-title { font-size: 24px; }
    .gp-side { padding: 20px 24px 22px; }
  }

  /* Phone: one column. Each goal is a row and its recommendation opens right under it. */
  @media (max-width: 767px) {
    .gp { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; background: #faf9f6; padding: 6px 0; }
    .gp::before { display: none; }
    .gp-row { grid-row: auto; margin: 2px 6px; min-height: 52px; scroll-margin-top: calc(76px + env(safe-area-inset-top, 0px)); }
    .gp-row:first-of-type { margin-top: 2px; }
    .gp-row-chev { opacity: 1; transform: rotate(90deg); }
    .gp-row.on .gp-row-chev { transform: rotate(-90deg); }
    .gp-card { grid-column: 1; grid-row: auto; margin: 2px 6px 8px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .gp-main { padding: 18px 18px 20px; gap: 11px; }
    .gp-title { font-size: 21px; line-height: 1.1; }
    .gp-reason { font-size: 14px; line-height: 1.55; }
    .gp .btn { width: 100%; justify-content: center; min-height: 44px; }
    .gp-actions { gap: 10px; }
    .gp-side { padding: 16px 18px 18px; }
    /* A 44px tap area around the inline link, without moving its underline. */
    .gp-alt a { position: relative; }
    .gp-alt a::after { content: ""; position: absolute; inset: -12px 0; }
  }
</style>

<script>
  import { mountGoalPickers } from '../lib/goal-picker';
  document.addEventListener('astro:page-load', () => mountGoalPickers());
</script>
